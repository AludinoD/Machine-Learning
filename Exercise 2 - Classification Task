cution":{"iopub.execute_input":"2026-11-24T13:53:52.922502Z","iopub.status.busy":"2026-11-24T13:53:52.921196Z","iopub.status.idle":"2026-11-24T13:53:52.94021Z","shell.execute_reply":"2026-11-24T13:53:52.938881Z"},"papermill":{"duration":0.028845,"end_time":"2026-11-24T13:53:52.942618+00:00","exception":false,"start_time":"2026-11-24T13:53:52.913773+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Logistic Regression Evaluation\n","Accuracy:  0.6955\n","Precision: 0.7328\n","Recall:    0.5624\n","F1-score:  0.6364\n"]}],"source":["# Calculate the model's accuracy\n","accuracy = accuracy_score(y_test, y_pred)\n","\n","# Calculate precision\n","precision = precision_score(y_test, y_pred, zero_division=0)\n","\n","# Calculate recall\n","recall = recall_score(y_test, y_pred, zero_division=0)\n","\n","# Calculate F1-score\n","f1 = f1_score(y_test, y_pred, zero_division=0)\n","\n","# Display the evaluation results\n","print(\"Logistic Regression Evaluation\")\n","\n","print(f\"Accuracy:  {accuracy:.4f}\")\n","print(f\"Precision: {precision:.4f}\")\n","print(f\"Recall:    {recall:.4f}\")\n","print(f\"F1-score:  {f1:.4f}\")"]},{"cell_type":"markdown","id":"5a9449d0","metadata":{"papermill":{"duration":0.005831,"end_time":"2026-11-24T13:53:52.954531+00:00","exception":false,"start_time":"2026-11-24T13:53:52.9487+00:00","status":"completed"},"tags":[]},"source":["The classification report provides a more detailed breakdown of the model's performance for both classes (0 and 1)."]},{"cell_type":"code","execution_count":16,"id":"a98da94c","metadata":{"execution":{"iopub.execute_input":"2026-11-24T13:53:52.969889Z","iopub.status.busy":"2026-11-24T13:53:52.968904Z","iopub.status.idle":"2026-11-24T13:53:52.984835Z","shell.execute_reply":"2026-11-24T13:53:52.983415Z"},"papermill":{"duration":0.02653,"end_time":"2026-11-24T13:53:52.98692+00:00","exception":false,"start_time":"2026-11-24T13:53:52.96039+00:00","status":"completed"},"tag